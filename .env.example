# Headstash environment variables
#
# Copy to .env (do not commit .env)

# Runtime mode
NODE_ENV="development"

# Required in all environments
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
# For NextAuth v4 these are typically called NEXTAUTH_URL / NEXTAUTH_SECRET.
# Headstash accepts either AUTH_* or NEXTAUTH_* aliases.
# - development/test: optional (falls back to safe local defaults)
# - production: required (must set secret + URL explicitly)
AUTH_SECRET="dev-secret-not-for-production"
AUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="dev-secret-not-for-production"
# NEXTAUTH_URL="http://localhost:3000"

# Local auth mode
# - full (default): credentials + optional GitHub + email magic link
# - credentials-only: disables GitHub and email magic link for local parity workflows
AUTH_LOCAL_MODE="full"
# AUTH_LOCAL_MODE="credentials-only"

# GitHub OAuth (optional)
# If either var is set, BOTH must be set.
# GITHUB_CLIENT_ID="..."
# GITHUB_CLIENT_SECRET="..."

# Email magic link SMTP (optional)
# If SMTP is enabled, set ALL of these together.
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="user"
# EMAIL_SERVER_PASSWORD="pass"
# EMAIL_FROM="Headstash <no-reply@example.com>"

# Prisma observability (optional)
PRISMA_SLOW_QUERY_THRESHOLD_MS="100"
