# Headstash environment variables
#
# Copy to .env (do not commit .env)
#
# SQLite (local dev)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
# For NextAuth v4 these are typically called NEXTAUTH_URL / NEXTAUTH_SECRET.
# We support both AUTH_* and NEXTAUTH_* env var names.
AUTH_SECRET="dev-secret-not-for-production"
AUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="dev-secret-not-for-production"
# NEXTAUTH_URL="http://localhost:3000"

# Email magic link (optional; if omitted, Headstash logs magic links to the dev console)
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="user"
# EMAIL_SERVER_PASSWORD="pass"
# EMAIL_FROM="Headstash <no-reply@example.com>"
